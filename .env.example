# Copy this file to `.env` and fill in your key:  cp .env.example .env
#
# OpenWeather — free "Current Weather" API key: https://openweathermap.org/api
# docker-compose injects this into the backend as APP_OPENWEATHER_API_KEY.
# Leave it empty and the /api/v1/weather endpoint simply returns 503 (the UI
# shows a "not configured" note instead of live weather).
OPENWEATHER_API_KEY=
